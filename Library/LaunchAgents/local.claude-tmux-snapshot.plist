<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs ~/.bin/claude-tmux-snapshot every two minutes. See that script. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.claude-tmux-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.bin/claude-tmux-snapshot"</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/claude-tmux-snapshot.log</string>
</dict>
</plist>
