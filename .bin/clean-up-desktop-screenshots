#!/usr/bin/env bash

# Deletes macOS screenshots sitting loose on the Desktop that are more than 5
# days old. Screenshots inside folders on the Desktop are left alone, because
# moving one into a folder means I want to keep it. Run from cron.

set -eo pipefail

max_age_minutes=$((5 * 24 * 60))

find "$HOME/Desktop" -maxdepth 1 -type f \
  \( -name 'Screenshot *.png' -o -name 'Screen Shot *.png' \) \
  -mmin "+$max_age_minutes" \
  -print -delete
