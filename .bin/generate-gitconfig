#!/usr/bin/env bash

email="dave.yarwood@gmail.com"

if [[ "$(uname)" == Darwin ]]; then
  # HACK: This isn't really macOS specific, but this happens to be the email
  # that I want to use on my work laptop.
  email="david.yarwood@fieldguide.io"
fi

cat <<EOF > "$HOME/.gitconfig"
# This gitconfig was generated via ~/.bin/generate-gitconfig.
# Edit that file, not this one!

[user]
  name = Dave Yarwood
  email = $email

[commit]
  gpgsign = true

[credential]
  helper = !gh auth git-credential

# Force all GitHub remotes through HTTPS, even when a URL is SSH-flavored.
[url "https://github.com/"]
  insteadOf = git@github.com:
  insteadOf = ssh://git@github.com/

[init]
  defaultBranch = main

[push]
  default = simple

[pull]
  rebase = true

[rerere]
  enabled = true

[core]
  autocrlf = input
  editor = nvim
  excludesfile = $HOME/.gitignore_global
  pager = delta

[interactive]
  diffFilter = delta --color-only
EOF
