#!/usr/bin/env ruby

require "etc"

if ARGV.length != 1
  STDERR.puts "Usage: #{$0} CPU_THRESHOLD"
  exit 1
end

cpu_threshold = Float(ARGV[0])

unless system("command -v pidstat > /dev/null 2>&1")
  STDERR.puts "pidstat not found. Install sysstat."
  exit 1
end

# pidstat samples CPU over a real interval (1s here), giving *current* usage
# rather than `ps aux`'s lifetime average. `-l` prints the full command line.
# `S_TIME_FORMAT=ISO` keeps the timestamp a single `HH:MM:SS` token (instead
# of the locale's `HH:MM:SS PM`), which makes the columns line up predictably.
ENV["S_TIME_FORMAT"] = "ISO"

self_pid = Process.pid.to_s
script_name = File.basename($0)

rows = `pidstat -u -l 1 1`.lines.filter_map do |line|
  fields = line.split

  # Data rows start with a `HH:MM:SS` timestamp; the banner, header, and
  # `Average:` block don't. Columns: 0=time 1=uid 2=pid 3..6=usr/sys/guest/wait
  # 7=%CPU 8=core 9..=command.
  next unless fields[0]&.match?(/\A\d{2}:\d{2}:\d{2}\z/)

  pid = fields[2]
  cpu = fields[7]
  command = fields[9..].join(" ")

  # Don't list this script or the pidstat subprocess itself.
  next if pid == self_pid
  next if command.include?(script_name) || command.start_with?("pidstat")

  [cpu.to_f, pid, fields[1], command, cpu]
end

rows.sort_by! { |cpu, _, _, _, _| -cpu }

rows.each do |cpu, pid, uid, command, cpu_str|
  break if cpu <= cpu_threshold

  user = begin
    Etc.getpwuid(uid.to_i).name
  rescue ArgumentError
    uid
  end

  puts "#{pid}\t#{user}\t#{cpu_str}\t#{command}"
end
