# Version-control metadata (never symlink into ~)
\.git
\.gitignore
\.gitmodules

# Repo-root files that aren't config to install
install\.sh
AGENTS\.md
README\.md

# Project-level Claude Code config for this repo (settings.local.json etc.).
# The repo root mirrors $HOME, so stowing this would land it in ~/.claude as
# user-level config. ~/.claude's contents are linked by install.sh instead.
\.claude

# Editor artifacts (never symlink into ~)
\..*\.sw.$       # vim/nvim swap files
.+~              # backup files
\#.*\#           # emacs autosave files
